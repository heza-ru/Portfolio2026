# Cloudflare Workers / Pages — response headers
# Applied to every request unless a more specific rule overrides it.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed JS/CSS bundles from Vite — safe to cache for one year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# GLB model — large, versioned via filename, one-week cache
/*.glb
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Web manifest — short cache so icon/name updates propagate quickly
/*.webmanifest
  Content-Type: application/manifest+json; charset=UTF-8
  Cache-Control: public, max-age=86400

# Sitemap and robots — daily freshness
/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

# ads.txt — must be text/plain for DSPs and advertisers
/ads.txt
  Content-Type: text/plain; charset=UTF-8
  Cache-Control: public, max-age=86400

# Custom 404 page
/404.html
  Content-Type: text/html; charset=UTF-8
  Cache-Control: public, max-age=0, must-revalidate

# HTML pages — always revalidate; include charset so audit tools don't flag it
/
  Content-Type: text/html; charset=UTF-8
  Cache-Control: public, max-age=0, must-revalidate

/labs/
  Content-Type: text/html; charset=UTF-8
  Cache-Control: public, max-age=0, must-revalidate

/logs/
  Content-Type: text/html; charset=UTF-8
  Cache-Control: public, max-age=0, must-revalidate
